{
  "name": "orbit-board",
  "private": true,
  "description": "Tooling for the ORBIT prioritization board. The board itself has no dependencies; these are for checks only.",
  "scripts": {
    "check": "node tools/check.mjs prioritization-board-grid.html",
    "audit:export": "node tools/export-audit/audit.mjs",
    "audit:ppt": "node tools/export-audit/audit-ppt.mjs",
    "audit:other": "node tools/export-audit/audit-other.mjs",
    "audit": "npm run audit:suites --silent",
    "mutate": "node tools/export-audit/mutate.mjs",
    "shoot": "node tools/export-audit/shoot.mjs",
    "layout": "node tools/layout-fits.mjs",
    "controls": "node tools/row-controls.mjs --check",
    "inspector": "node tools/inspector-agrees.mjs",
    "verify:grid": "npm run chrome --silent && npm run controls --silent && npm run inspector --silent && npm run toolbar --silent && npm run editors --silent && npm run colours --silent && npm run menus --silent && npm run panels --silent && npm run frames --silent && npm run hostile --silent && npm run layout --silent && npm run keys --silent && npm run dropdowns --silent && npm run dialogs --silent",
    "toolbar": "node tools/toolbar-fits.mjs",
    "audit:board": "node tools/export-audit/audit-board.mjs",
    "audit:legacy": "node tools/export-audit/legacy-fsrc.mjs",
    "audit:import": "node tools/export-audit/audit-import.mjs",
    "editors": "node tools/editors-reachable.mjs",
    "audit:recon": "node tools/export-audit/audit-recon.mjs",
    "audit:hostile": "node tools/export-audit/audit-hostile.mjs",
    "audit:inject": "node tools/export-audit/audit-inject.mjs",
    "colours": "node tools/colour-check.mjs",
    "panels": "node tools/panels-render.mjs",
    "hostile": "node tools/hostile-render.mjs",
    "frames": "node tools/fydp-frames.mjs",
    "menus": "node tools/menu-paths.mjs",
    "audit:suites": "node tools/export-audit/boot-same.mjs && npm run audit:export && npm run audit:ppt && npm run audit:other && npm run audit:board && npm run audit:import && npm run audit:recon && npm run audit:legacy && npm run audit:hostile && npm run audit:inject",
    "coverage:money": "node tools/money-coverage.mjs",
    "validate:math": "node tools/validate-math.mjs",
    "trace": "node tools/trace-matrix.mjs",
    "money-map": "node tools/money-map.mjs",
    "ia:census": "node tools/ia-census.mjs",
    "ia:shots": "node tools/ia-shots.mjs",
    "ia": "npm run ia:census --silent && npm run ia:shots --silent",
    "fuzz": "node tools/roundtrip-fuzz.mjs",
    "delta": "node tools/export-delta.mjs",
    "defects": "node tools/math-defects.mjs",
    "standards": "node tools/standards-check.mjs",
    "verify:file": "node tools/verify-file.mjs",
    "chrome": "node tools/chrome.mjs --selftest",
    "keys": "node tools/keyboard-reach.mjs",
    "dropdowns": "node tools/dropdowns-visible.mjs",
    "dialogs": "node tools/dialogs-keyboard.mjs"
  },
  "devDependencies": {
    "jsdom": "^27.0.0"
  },
  "dependencies": {
    "playwright-core": "^1.63.0"
  }
}
