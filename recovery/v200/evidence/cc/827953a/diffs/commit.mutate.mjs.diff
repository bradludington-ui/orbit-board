+  { id: "v200-u10-journal-putback-sync-only", area: "jrnlUndo", what: "no gate: Put back only leaves the journal's shadow alone in a view and runs on to its refused save; the status line then says \"🔒 Not kept — PB27 is a locked view. ↶ Put back: note — Ev F1 — recorded in the journal.\", though nothing was recorded, after asking its question",
+    find: "  if(cycBlock('Putting a change back')) return;\n  const e=(MS.jrnl||[])[i];\n  if(!jrnlUndoable(e)){ setStat('⚠ That entry cannot be put back automatically — it is a load, a line saying what could not be recorded, a figure recorded by its service’s place before the service list changed, or the value is too large to have been recorded in full.'); return; }\n  if(!confirm('Put '+diagPlain(jrnlLabel(e))+' back to what it was before '+(e.by||'?')+' changed it?\\n\\nThis is recorded in the journal too.')) return;\n  const fy=e.fy||MS.cur;\n  if(!jrnlSet(fy, e.p, e.a)){ setStat('⚠ That value could not be put back — the shape of the state has moved on since.'); return; }\n  if(fy===MS.cur) applyState(MS.years[MS.cur]);\n  // A reversal is a decision, and BOTH it and the change it reverses must stand. Capturing the\n  // revert first folded it into the original entry and then dropped that entry as a no-op, which\n  // erased the very change being reverted. The revert's own diff is discarded; the reversal is\n  // added as its own line.\n  jrnlSync();\n",
+    repl: "  const e=(MS.jrnl||[])[i];\n  if(!jrnlUndoable(e)){ setStat('⚠ That entry cannot be put back automatically — it is a load, a line saying what could not be recorded, a figure recorded by its service’s place before the service list changed, or the value is too large to have been recorded in full.'); return; }\n  if(!confirm('Put '+diagPlain(jrnlLabel(e))+' back to what it was before '+(e.by||'?')+' changed it?\\n\\nThis is recorded in the journal too.')) return;\n  const fy=e.fy||MS.cur;\n  if(!jrnlSet(fy, e.p, e.a)){ setStat('⚠ That value could not be put back — the shape of the state has moved on since.'); return; }\n  if(fy===MS.cur) applyState(MS.years[MS.cur]);\n  // A reversal is a decision, and BOTH it and the change it reverses must stand. Capturing the\n  // revert first folded it into the original entry and then dropped that entry as a no-op, which\n  // erased the very change being reverted. The revert's own diff is discarded; the reversal is\n  // added as its own line.\n  if(!CYCVIEW) jrnlSync();\n" },
