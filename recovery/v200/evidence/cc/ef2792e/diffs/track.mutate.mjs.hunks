   // v2.00 (U10, fix round 3 of 13 Oct): the shared folder read while a view is put on screen -- Load theirs refused once the folder
   // is read; the refresh's gate after its last wait, and quiet when nobody asked -- and the shared state file's answer at opening.
   { id: "v200-u10-resolve-race", area: "_driveResolveRun", what: "Load theirs started on the working plan, with PB27 put on screen while the shared folder is read, keeps the locked cycle aside as this browser's work and says \"the change was not kept\"; back on the working plan Load theirs is refused (work already kept aside), and \"put it back\" makes PB27's plan the working plan",
-    find: "  if(CYCVIEW){ cycRefuse('Loading a board'); render(); return false; }\n  if(!j){ driveBaseSet(ap, 0); return await _driveStorePushRun(false); }",
+    find: "  if(CYCVIEW){ cycRefuse(which==='mine'? 'Writing to the shared folder' : 'Loading a board'); render(); return false; }\n  if(!j){ driveBaseSet(ap, 0); return await _driveStorePushRun(false); }",
     repl: "  if(!j){ driveBaseSet(ap, 0); return await _driveStorePushRun(false); }" },
   { id: "v200-u10-folder-pull-view-at-start", area: "driveStorePull", what: "the refresh reads the view once, when it starts -- as a gate checked before the folder is read would: a Live refresh started on the working plan, with PB27 put on screen while the folder's copy is read, keeps the cycle aside as this browser's work and records the folder's copy as the one the work came from, saved; after leaving the view the next refresh loads Colleague C's copy, and the work typed (MY UNSAVED A) is in no copy",
     find: "async function driveStorePull(quiet){",
@@
   { id: "v200-u10-journal-putback-in-view", area: "jrnlUndo", what: "↶ Put back in PB27's view runs on to its own save, which the view refuses: the journal's shadow is first taken from the cycle on screen, and the next save on the working plan records every difference between PB27 and the working plan as the saver's own changes (F1's $1,200,000,000 credited to Me M)",
     find: "  if(cycBlock('Putting a change back')) return;\n",
     repl: "" },
+  // v2.00 (U10, fix round 4 of 13 Oct): Save yours over theirs, raced by a view put on screen while the folder is read, is refused
+  // as a save, before its question.
+  { id: "v200-u10-resolve-gate-theirs-only", area: "_driveResolveRun", what: "the gate after the folder read stands before Load theirs only: Save yours over theirs pressed on the working plan, with PB27 put on screen while the folder is read, asks its question and writes Colleague C's copy into the folder's history before the save is refused",
+    find: "  if(CYCVIEW){ cycRefuse(which==='mine'? 'Writing to the shared folder' : 'Loading a board'); render(); return false; }\n",
+    repl: "  if(CYCVIEW && which!=='mine'){ cycRefuse(which==='mine'? 'Writing to the shared folder' : 'Loading a board'); render(); return false; }\n" },
+  { id: "v200-u10-resolve-mine-words", area: "_driveResolveRun", what: "Save yours over theirs, raced by a view, is refused in Load theirs' words: \"🔒 Loading a board is off while PB27 is on screen\" for a save",
+    find: "  if(CYCVIEW){ cycRefuse(which==='mine'? 'Writing to the shared folder' : 'Loading a board'); render(); return false; }\n",
+    repl: "  if(CYCVIEW){ cycRefuse('Loading a board'); render(); return false; }\n" },
   // v2.00 (R3, Brad 11 Oct): a save that lands under a locked view says it saved the working plan.
   { id: "v200-r3-landed-view-unsaid", area: "_driveStorePushRun", what: "a folder save that lands while a locked view is on screen says “🔒 Not kept — PB27 is a locked view. ✅ Saved …” again, naming no plan (or, quiet, leaves persist's refusal on screen)",
     find: "  if(CYCVIEW){ _cycRefusedAt=0; setStat('✅ <b>Saved the working plan</b> of '+esc(APPN_LBL[ap]||ap)+' FY'+(fy%100)+' to the shared folder — '\n    +Math.round(body.length/1024)+' KB, built before '+blLbl(CYCVIEW)+' was put on screen. '+blLbl(CYCVIEW)+' is a locked view: nothing in it '\n    +'is saved. Everyone sees the working plan on their next refresh.'+penNote+lateNote); render(); return true; }\n",
