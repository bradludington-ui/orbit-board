DEBUG FLOW {"flow":[["F-35 Sustainment Finance — Funds Flow"],["Scope: FY27–FY31 · all years · all appropriations · PLANNED (board allocation, O&M)"],["Source: imported CCaR QPE · all plan-event dollars (obligations and forecast) · whole dollars"],["NOTE: separate appropriation years added together — a portfolio total, not one year of funding. Fiscal years included: FY2027, FY2028, FY2029, FY2030, FY2031."],[],["International Partner and FMS money is typed per fiscal year for the whole portfolio: it is counted once, for the years in scope, and the appropriation selection does not change it."],[],["TOTAL FUNDING"],["Source","Amount"],["US service appropriations",1100],["International Partners",0],["Foreign Military Sales",0],["TOTAL FUNDING",1100],[],["US SERVICE FUNDING BY APPROPRIATION"],["Everything below divides US service appropriations only — partner and FMS money is not broken out by contractor, so the percentages are of that figure, not of total funding."],["Appropriation","Amount","% of US funding"],["O&M",1100,"100.0%"],["FULL FUND",0,"0.0%"],["INITIAL SPARES",0,"0.0%"],["OPN",0,"0.0%"],["US SERVICE FUNDING",1100,"100.0%"],[],["JPO CONTRACTS — PRIME"],["Prime","Amount","% of US funding","Plan events"],["Lockheed Martin",0,"0.0%",0],["Pratt & Whitney",0,"0.0%",0],["Prime total",0,"0.0%",0],[],["OTHER GOVERNMENT COSTS (OGCs) — BY WHAT THE MONEY BUYS"],["Category","Amount","% of US funding","% of OGCs","Plan events"],["Lockheed Martin",0,"0.0%","0.0%",0],["Pratt & Whitney",0,"0.0%","0.0%",0],["NAWCAD Patuxent River",0,"0.0%","0.0%",0],["NAWCWD China Lake",0,"0.0%","0.0%",0],["FRC East, Cherry Point",0,"0.0%","0.0%",0],["NAWCAD Lakehurst",0,"0.0%","0.0%",0],["Defense Logistics Agency",0,"0.0%","0.0%",0],["OC-ALC Oklahoma City",0,"0.0%","0.0%",0],["DDDDDDDDDDDDDDDDDDDDDDDDDDD😀tail",0,"0.0%","0.0%",0],["'Quoted depot'",0,"0.0%","0.0%",0],["EEEEEEEEEEEEEEEEEEEEEEEEE😀A-one",0,"0.0%","0.0%",0],["EEEEEEEEEEEEEEEEEEEEEEEEE😀A-two",0,"0.0%","0.0%",0],["FFFFFFFFFFFFFFFFFFFFFFFFFFF'tail",0,"0.0%","0.0%",0],["O'Brien",0,"0.0%","0.0%",0],["Plain depot",0,"0.0%","0.0%",0],["Split between destinations — resolve",0,"0.0%","0.0%",0],["Not yet assigned",1100,"100.0%","100.0%",2],["OGC total",1100,"100.0%","100.0%"],[],["OTHER SOURCES — PORTFOLIO-WIDE: in total funding, not an appropriation, not changed by the appropriation selection"],["Source","Amount","% of total funding"],["International Partners",0,"0.0%"],["Foreign Military Sales",0,"0.0%"],["Other sources total",0,"0.0%"],[],["RECONCILIATION"],["US service appropriations",1100,"100.0%"],["Other sources",0,"0.0%"],["TOTAL FUNDING",1100,"100.0%"],[],["Prime match tokens — Lockheed Martin: LM · Pratt & Whitney: PW, P&W, PRATT · looked for in: requirement title + plan event"],[],["HOW EACH OGC CATEGORY WAS DECIDED"],["Applied in this order; the first rule that matches wins, and the last takes the remainder."],["#","Category","Category cell contains","or these whole words in the title"],[1,"Lockheed Martin","— the remainder —"],[2,"Pratt & Whitney","— the remainder —"],[3,"NAWCAD Patuxent River","— the remainder —"],[4,"NAWCWD China Lake","— the remainder —"],[5,"FRC East, Cherry Point","— the remainder —"],[6,"NAWCAD Lakehurst","— the remainder —"],[7,"Defense Logistics Agency","— the remainder —"],[8,"OC-ALC Oklahoma City","— the remainder —"],[9,"DDDDDDDDDDDDDDDDDDDDDDDDDDD😀tail","— the remainder —"],[10,"'Quoted depot'","— the remainder —"],[11,"EEEEEEEEEEEEEEEEEEEEEEEEE😀A-one","— the remainder —"],[12,"EEEEEEEEEEEEEEEEEEEEEEEEE😀A-two","— the remainder —"],[13,"FFFFFFFFFFFFFFFFFFFFFFFFFFF'tail","— the remainder —"],[14,"O'Brien","— the remainder —"],[15,"Plain depot","— the remainder —"],[16,"Split between destinations — resolve","— the remainder —"],[17,"Not yet assigned","— the remainder —"]],"plain":[["Requirement","Plan event","Appropriation","PMO","Service","Amount","Status"]]}
